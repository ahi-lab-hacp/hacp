{
  "name": "@ahi-lab-hacp/core",
  "version": "0.2.0",
  "description": "Core types, cryptography, and verification for HACP",
  "license": "Apache-2.0",
  "homepage": "https://github.com/ahi-lab-hacp/hacp/tree/main/packages/core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ahi-lab-hacp/hacp.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/ahi-lab-hacp/hacp/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "README.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}

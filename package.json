{
  "name": "hacp",
  "version": "0.1.0",
  "private": true,
  "description": "Reference implementation of the Human–Agent Coordination Protocol",
  "license": "Apache-2.0",
  "author": "AHI.lab",
  "homepage": "https://ahi-lab.com/hacp",
  "repository": {
    "type": "git",
    "url": "https://github.com/ahi-lab-hacp/hacp.git"
  },
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "clean": "pnpm -r clean",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "pnpm -r typecheck",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && changeset publish"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.4",
    "@changesets/cli": "^2.29.7",
    "@types/node": "^22.18.3",
    "@vitest/coverage-v8": "^4.1.11",
    "tsup": "^8.5.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^4.1.11"
  }
}
